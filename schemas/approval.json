{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.clagentic.ai/approval/1.json",
  "title": "Clagentic operator approval claims",
  "description": "Claim set of the JWS payload of an operator approval, JWS typ clagentic-approval+jwt. Introduced in contract version 2.2.0. An approval is a sibling artifact of the identity assertion, not a claim of it. See docs/identity-contract.md section 13 for the verification order and failure codes.",
  "type": "object",
  "properties": {
    "iss": { "type": "string", "minLength": 1 },
    "rid": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "op": { "type": "string", "pattern": "^[A-Za-z0-9._:/@+-]{1,128}$" },
    "pd": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sid": { "type": "string", "minLength": 1 },
    "acked_by": { "type": "string", "pattern": "^[A-Za-z0-9._:@+-]{1,128}$" },
    "iat": { "type": "integer", "minimum": 0 },
    "exp": { "type": "integer", "minimum": 0 },
    "cap": { "type": "integer", "const": 1 }
  },
  "required": ["iss", "rid", "op", "pd", "sid", "acked_by", "iat", "exp", "cap"],
  "additionalProperties": true,
  "x-contract": {
    "version": "2.2.0",
    "typ": "clagentic-approval+jwt",
    "requiredAlways": ["iss", "rid", "op", "pd", "sid", "acked_by", "iat", "exp", "cap"],
    "maxLifetimeSeconds": 300
  }
}
